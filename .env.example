# Salin file ini ke ".env" lalu isi sendiri. JANGAN commit file ".env" ke git.

# Port server (untuk mode VPS/Hosting biasa)
PORT=3000

# Password admin untuk masuk ke /admin (ganti dengan yang kuat)
ADMIN_PASSWORD=ganti-password-ini

# Base URL publik website ini (dipakai untuk generate short URL agar tetap di domain sendiri)
# Contoh: https://exam.namadomainanda.com  (JANGAN diakhiri "/")
PUBLIC_BASE_URL=http://localhost:3000

# --- Login Google (OPSIONAL) ---
# Buat OAuth Client ID sendiri di https://console.cloud.google.com/apis/credentials
# Redirect URI yang didaftarkan di Google harus: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rahasia untuk menandatangani cookie session (isi string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Catatan keamanan:
# - Aplikasi ini TIDAK menyimpan/meng-upload token pribadi (GitHub, dll) secara otomatis kemana pun.
# - Semua kredensial di file ini hanya dipakai lokal oleh server, tidak pernah dikirim ke pihak ketiga.
